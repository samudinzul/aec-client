// version_exp.rc — app icon + version metadata for aec_exp.exe
// (the experimental fork). Mirrors version.rc: separate
// InternalName/OriginalFilename so the two exes are distinguishable
// in Task Manager, AV telemetry, and the release asserts (which only
// cover the official aec_gui build).
// Keep FILEVERSION/ProductVersion/FileVersion in sync with
// APP_VERSION in exp/main.cpp ("1.14.0-exp" — the -exp suffix marks
// experimental builds; numeric fields stay 1,14,0,0).

// Numeric ID on purpose (no resource.h): windres stores an undefined
// word like IDR_ICON1 as a *string* name, which Explorer ignores and
// LoadIcon(101) can never find. 101 must match MAKEINTRESOURCEW(101)
// in exp/main.cpp. Icon path is repo-root-relative via ../.. because
// windres resolves it from THIS file's directory (exp/).
101 ICON DISCARDABLE "../resources/app.ico"

1 VERSIONINFO
FILEVERSION     1,14,0,0
PRODUCTVERSION  1,14,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AEC Exp"
            VALUE "FileDescription",  "AEC Exp - experimental acoustic echo cancellation"
            VALUE "FileVersion",      "1.14.0-exp"
            VALUE "InternalName",     "aec_exp"
            VALUE "OriginalFilename", "aec_exp.exe"
            VALUE "ProductName",      "AEC Exp"
            VALUE "ProductVersion",   "1.14.0-exp"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
