// version.rc — app identity + icon for aec_gui.exe
//
// Embedding a custom icon changes the resource entropy of the PE header,
// which is sometimes enough to break the Wacatac.B!ml static pattern
// match on VirusTotal. It is a heuristic bypass, not a substitute for
// code signing — signing is still the only reliable fix.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,10,1,0
PRODUCTVERSION 1,10,1,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS VOS_NT_WIN32
FILESUBTYPE 0
FILETYPE VFT_APP

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "AEC Client"
            VALUE "FileDescription", "AEC Client"
            VALUE "FileVersion", "1.10.1"
            VALUE "ProductVersion", "1.10.1"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

IDR_ICON1 ICON DISCARDABLE "resources/app.ico"